---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Dead Inside Designs</title>
	</head>

	<body style="
		margin: 0;
		font-family: Arial, sans-serif;
		background-color: #cfd8e3;
		color: #1f2933;
	">

		<header style="
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 28px 40px;
			border-bottom: 1px solid #7f8c9a;
			background-color: #eef3f7;
		">

			<nav style="
				display: flex;
				gap: 28px;
				font-weight: bold;
			">
				<a href="/" style="text-decoration: none; color: #1f2933;">HOME</a>
				<a href="/contact" style="text-decoration: none; color: #1f2933;">CONTACT</a>
			</nav>

			<div style="
				font-size: 32px;
				font-weight: bold;
				letter-spacing: 8px;
				color: #2f4356;
				text-align: center;
			">
				DEAD INSIDE DESIGNS
			</div>

			<div></div>

		</header>

		<main style="
			max-width: 1200px;
			margin: 0 auto;
			padding: 50px 40px;
		">

			<section style="margin-bottom: 50px;">
				<p style="font-size: 20px; max-width: 700px; line-height: 1.6;">
					This page contains designs that shouldn't be taken too seriously.<br>
					You're free to download, use, modify.<br>
					Credit is nice. Donations too.
				</p>
			</section>

			<section>
				<h1 style="
					color: #1f2933;
					font-size: 32px;
					margin-bottom: 35px;
					letter-spacing: 1px;
				">
					DESIGNS
				</h1>

				<div style="
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
					gap: 36px;
				">

					<a href="/designs/live-love-leopard" style="
						text-decoration: none;
						color: #1f2933;
					">
						<img
							src="/designs/liveLoveLeopard.png"
							alt="Live Love Leopard"
							style="
								width: 100%;
								aspect-ratio: 16 / 9;
								object-fit: cover;
								display: block;
								border-radius: 4px;
							"
						>

						<h2 style="
							font-size: 24px;
							margin-top: 18px;
							color: #1f2933;
							line-height: 1.2;
						">
							Live Love Leopard
						</h2>
					</a>

				</div>
			</section>

		</main>

	</body>
</html>